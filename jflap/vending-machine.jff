    <transition><from>1</from><to>0</to><read>C</read><transout>PRODUTO</transout></transition>

    <transition><from>2</from><to>3</to><read>A</read><transout>ε</transout></transition>
    <transition><from>2</from><to>4</to><read>B</read><transout>ε</transout></transition>
    <transition><from>2</from><to>0</to><read>C</read><transout>PRODUTO + TROCO 5c</transout></transition>

    <transition><from>3</from><to>4</to><read>A</read><transout>ε</transout></transition>
    <transition><from>3</from><to>5</to><read>B</read><transout>ε</transout></transition>
