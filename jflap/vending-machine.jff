<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
  <type>mealy</type>
  <automaton>
    <state id="0" name="q0">
      <x>100.0</x>
      <y>250.0</y>
      <initial/>
    </state>
    <state id="1" name="q5">
      <x>300.0</x>
      <y>100.0</y>
    </state>
    <state id="2" name="q10">
      <x>300.0</x>
      <y>250.0</y>
